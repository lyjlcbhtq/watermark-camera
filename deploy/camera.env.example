# Copy to /etc/watermark-camera.env; do not put the real key in the public directory.
CAMERA_HOST=127.0.0.1
CAMERA_PORT=8080
# Must start AND end with /. Use /watermark-camera/ for a subpath deployment.
CAMERA_BASE_PATH=/
# Only enable behind the bundled loopback reverse proxy, which overwrites X-Real-IP.
CAMERA_TRUST_PROXY=1
# Amap Web Service key, kept only on this server. Empty = coordinates still work,
# address lookup returns SERVICE_NOT_CONFIGURED instead of a fabricated address.
AMAP_WEB_SERVICE_KEY=
